# Copy to .env for local `npm run dev`. In production inject these as real env vars/secrets.

NODE_ENV=development
MODE=all                      # api | worker | all
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://email:email@localhost:5432/email
# true when the database is reached over a public/proxied TLS endpoint (most managed Postgres).
DATABASE_SSL=false

AWS_REGION=eu-west-1
# Prefer an IAM role (ECS task role / instance profile). Static keys only for local dev.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# From `npm run setup:aws`
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/emailsvc-send
# Required for /webhooks/ses: events from any other topic are rejected, and the webhook refuses to run without it.
SNS_EVENTS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:emailsvc-events
# Local ElasticMQ instead of real SQS:
# SQS_ENDPOINT=http://localhost:9324
# SQS_QUEUE_URL=http://localhost:9324/000000000000/emailsvc-send

SES_DRY_RUN=false             # true = log instead of calling SES
SES_CONFIG_SET_PREFIX=emailsvc
MAX_SEND_ATTEMPTS=5

# Long random string. Protects /admin/* (project, domain and API key management) and is the
# password for the admin UI at /admin/login.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Signs the admin session cookie (12 h). Optional: derived from ADMIN_TOKEN when unset.
# SESSION_SECRET=another-long-random-string
